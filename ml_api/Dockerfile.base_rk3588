# RK3588-specific base image (e.g. Turing Pi RK1)
# No CUDA/TensorRT - uses Rockchip NPU via rknn-toolkit-lite2

FROM ubuntu:22.04 as ml_api_base_rk3588

ENV DEBIAN_FRONTEND=noninteractive
RUN apt update && apt install --no-install-recommends -y \
    ca-certificates python3-pip wget curl

# Pinned to a commit, not master: this runtime has to match the
# rknn-toolkit-lite2 version in requirements_rk3588.txt, and a moving branch
# makes the pair drift apart silently. This one reports "librknnrt version:
# 2.3.2", which is the version pinned there, and CI asserts the two still agree.
# The checksum is what makes the pin exact: this is the runtime rknn-toolkit-
# lite2 loads underneath, so a file that is not the pinned one fails the build
# here rather than at inference time, where a version mismatch is a wrong
# answer rather than an error.
COPY scripts/fetch_verified.sh /usr/local/bin/fetch_verified
RUN fetch_verified \
      https://github.com/airockchip/rknn-toolkit2/raw/59a913d172e7f5ff03c9076e2ec7b1b1288ffd08/rknpu2/runtime/Linux/librknn_api/aarch64/librknnrt.so \
      /usr/lib/librknnrt.so 7000000 \
      d31fc19c85b85f6091b2bd0f6af9d962d5264a4e410bfb536402ec92bac738e8 \
    && chmod 755 /usr/lib/librknnrt.so

WORKDIR /app
RUN pip install --upgrade pip
# Pinned at the last 4.x that bounds numpy on both sides. The published bases
# hold OpenCV 4.9, whose wheel declares a numpy floor with no ceiling — pip now
# hands its numpy-1 ABI extension a numpy 2 and the import dies with
# _ARRAY_API not found. 4.12 fixes that inside the same major, so a rebuild
# stays on the OpenCV every deployment is already running; jumping to 5.x
# would also fix it, but 5 drops the legacy C API and the Darknet DNN parser
# and nothing here has been run on it. The wheel is abi3, which is why one
# version serves every base despite their different Python versions.
RUN pip install opencv_python_headless==4.12.0.88

ADD requirements.txt ./
ADD requirements_rk3588.txt ./
RUN pip install -r requirements.txt -r requirements_rk3588.txt

EXPOSE 3333
